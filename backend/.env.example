# SolSniperX Backend Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.

# Dexscreener API Key (optional, used for token data)
DEXSCREENER_API_KEY=

# Birdeye API Key (required for token security, historical data)
BIRDEYE_API_KEY=

# LLM7 API Key (required for AI analysis)
LLM7_API_KEY=

# Solana wallet private key (Base58 encoded) - REQUIRED for trading
# WARNING: Never share or commit this key. Loss = loss of all funds.
SOLANA_PRIVATE_KEY=

# Solana RPC endpoints (defaults to public endpoints if not set)
# For production, use a paid RPC provider (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com/

# CORS origin (defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Flask debug mode (set to true only for development)
FLASK_DEBUG=false
