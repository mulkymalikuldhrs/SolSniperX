# =============================================================================
# SolSniperX — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Solana Wallet ---
# Your Solana private key (base58 encoded). NEVER share this!
SOLANA_PRIVATE_KEY=
# RPC URL (use Helius/QuickNode for production, not the public endpoint)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com/

# --- API Keys ---
DEXSCREENER_API_KEY=
BIRDEYE_API_KEY=
LLM7_API_KEY=

# --- CORS ---
# Allowed origins for CORS (comma-separated). Set to your frontend URL.
CORS_ORIGIN=http://localhost:5173
